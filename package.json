{
  "name": "tfrs16-financial-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "TFRS 16 Financial Intelligence Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:golden": "jest test/golden --runInBand",
    "golden:baseline": "GOLDEN_WRITE=1 jest test/golden/baseline-writer.test.js --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "jest --runInBand && playwright test",
    "lint": "npx --yes eslint@8.57.1 js/tfrs16.js --max-warnings=217"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^7.1.4"
  }
}
