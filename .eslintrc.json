{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error", "info", "time", "timeEnd"] }],
    "no-undef": "warn",
    "eqeqeq": ["warn", "always"],
    "curly": "off",
    "no-empty": "warn",
    "no-func-assign": "warn",
    "no-unreachable": "warn",
    "no-dupe-keys": "warn",
    "no-useless-escape": "warn",
    "no-var": "warn",
    "prefer-const": "warn"
  },
  "globals": {
    "contracts": "readonly",
    "selectedContractId": "writable",
    "bulkJournalData": "writable",
    "XLSX": "readonly",
    "localStorage": "readonly",
    "document": "readonly",
    "window": "readonly",
    "console": "readonly",
    "alert": "readonly",
    "confirm": "readonly",
    "fetch": "readonly",
    "DOMParser": "readonly",
    "Blob": "readonly",
    "URL": "readonly"
  }
}
