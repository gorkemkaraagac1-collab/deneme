# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tuik_inflation_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# API & Service Settings
TUIK_API_URL=https://api.tuik.gov.tr/
TUIK_API_KEY=your_tuik_api_key_here

# Cache & Redis Settings (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging Settings
LOG_LEVEL=info
