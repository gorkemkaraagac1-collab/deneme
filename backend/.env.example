# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tuik_inflation_db
DB_USER=postgres
DB_PASSWORD=

# API & Service Settings
TUIK_API_URL=https://api.tuik.gov.tr/
TUIK_API_KEY=

# Cache & Redis Settings (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging Settings
LOG_LEVEL=info

# Authentication (required)
# Production: inject JWT_SECRET from Secret Manager; never commit real values.
JWT_SECRET=
JWT_EXPIRES_IN=8h
