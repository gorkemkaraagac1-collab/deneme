# ============================================================
# SERVER
# ============================================================
PORT=3000

# development | test | production
# GÜVENLİK: NODE_ENV=production; CORS fail-closed davranışını,
# HSTS header'ını ve varsayılan DB SSL zorunluluğunu tetikler
# (bkz. backend/app.js, backend/middleware/security-headers.js,
# backend/db/pool.js).
NODE_ENV=development

# ============================================================
# DATABASE
# ============================================================
# Bu değişkenlerin TÜMÜ zorunludur — DB_USER, DB_PASSWORD veya
# DB_NAME tanımlı değilse backend/db/pool.js sunucunun zayıf bir
# varsayılanla (ör. "password") başlamasını ENGELLEMEK için
# başlangıçta hata fırlatır.
DB_HOST=localhost
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME_before_deploy
DB_NAME=tfrs16

# "true" | "false" — tanımsızsa NODE_ENV=production olduğunda
# otomatik olarak SSL zorunlu kılınır. Yönetilen (managed)
# Postgres sağlayıcılarının çoğu (RDS, Cloud SQL vb.) SSL ister.
DB_SSL=true
# Yalnızca self-signed sertifika kullanan ortamlarda "false"
# yapılması gerekebilir; aksi halde varsayılan (true) bırakılmalıdır.
DB_SSL_REJECT_UNAUTHORIZED=true

# Bağlantı havuzu ayarları (isteğe bağlı — verilmezse makul
# varsayılanlar kullanılır, bkz. backend/db/pool.js).
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ============================================================
# AUTHENTICATION / JWT
# ============================================================
# `openssl rand -hex 32` ile üretilmiş, güçlü ve rastgele bir
# değer kullanın. Bu değer olmadan sunucu başlamayı reddeder
# (bkz. backend/utils/jwt.js).
JWT_SECRET=CHANGE_ME_before_deploy
JWT_EXPIRES_IN=8h

# ============================================================
# CORS
# ============================================================
# Virgülle ayrılmış, izin verilen origin listesi
# (ör. "https://app.example.com,https://admin.example.com").
# Production'da bu değişken TANIMLANMADIYSA hiçbir cross-origin
# isteğe izin verilmez (fail-closed) — bkz. backend/app.js.
CORS_ORIGINS=

# ============================================================
# REVERSE PROXY / LOAD BALANCER
# ============================================================
# Servis bir reverse proxy / load balancer arkasında çalışıyorsa
# (production'da genellikle öyledir), gerçek istemci IP'sinin
# (X-Forwarded-For üzerinden) doğru okunması — ve dolayısıyla
# rate limiting'in doğru IP'ye uygulanması — için ayarlanmalıdır.
# Express'in "trust proxy" ayarına aktarılır (ör. "1" = yalnızca
# ilk hop'a güven). Boş bırakılırsa (varsayılan) KAPALIDIR —
# aksi halde bir saldırgan X-Forwarded-For header'ını sahteleyerek
# rate limiting'i atlatabilir. Yalnızca gerçekten güvenilir bir
# proxy'nin arkasındaysanız ayarlayın.
TRUST_PROXY=

# ============================================================
# RATE LIMITING (opsiyonel — verilmezse aşağıdaki varsayılanlar
# kullanılır, bkz. backend/middleware/rate-limit.js)
# ============================================================
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# REGISTER_RATE_LIMIT_MAX=30
# REGISTER_RATE_LIMIT_WINDOW_MS=900000
# ADMIN_RATE_LIMIT_MAX=300
# ADMIN_RATE_LIMIT_WINDOW_MS=900000
